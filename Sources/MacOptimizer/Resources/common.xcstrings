    "Hello! I’m your MacOptimizer AI assistant. I can analyze your system, clean junk files, and check for app updates. How can I help?": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hello! I’m your MacOptimizer AI assistant. I can analyze your system, clean junk files, and check for app updates. How can I help?"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Merhaba! Ben MacOptimizer yapay zekâ asistanınızım. Sisteminizi analiz edebilir, gereksiz dosyaları temizleyebilir ve uygulama güncellemelerini denetleyebilirim. Size nasıl yardımcı olabilirim?"
          }
        }
      }
    },
