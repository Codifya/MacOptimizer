<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Found and listed %lld models from NVIDIA NIM.</key><dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
    <key>count</key><dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>lld</string>
      <key>one</key><string>Found and listed one model from NVIDIA NIM.</string>
      <key>other</key><string>Found and listed %lld models from NVIDIA NIM.</string>
    </dict>
  </dict>
  <key>%lld items cleaned successfully.</key><dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
    <key>count</key><dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>lld</string>
      <key>one</key><string>One item cleaned successfully.</string>
      <key>other</key><string>%lld items cleaned successfully.</string>
    </dict>
  </dict>
  <key>%lld items skipped.</key><dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
    <key>count</key><dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>lld</string>
      <key>one</key><string>One item skipped.</string>
      <key>other</key><string>%lld items skipped.</string>
    </dict>
  </dict>
  <key>%lld apps found.</key><dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
    <key>count</key><dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>lld</string>
      <key>one</key><string>One app found.</string>
      <key>other</key><string>%lld apps found.</string>
    </dict>
  </dict>
  <key>%lld updates available!</key><dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
    <key>count</key><dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>lld</string>
      <key>one</key><string>One update available!</string>
      <key>other</key><string>%lld updates available!</string>
    </dict>
  </dict>
  <key>%lld associated files deleted.</key><dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
    <key>count</key><dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>lld</string>
      <key>one</key><string>One associated file deleted.</string>
      <key>other</key><string>%lld associated files deleted.</string>
    </dict>
  </dict>
  <key>%lld duplicate file groups found.</key><dict>
    <key>NSStringLocalizedFormatKey</key><string>%#@count@</string>
    <key>count</key><dict>
      <key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string>
      <key>NSStringFormatValueTypeKey</key><string>lld</string>
      <key>one</key><string>One duplicate file group found.</string>
      <key>other</key><string>%lld duplicate file groups found.</string>
    </dict>
  </dict>
</dict></plist>
