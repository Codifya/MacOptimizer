<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>%lld items, %@ in total. This action cannot be undone.</key><dict>
<key>NSStringLocalizedFormatKey</key><string>%#@items@, %@ in total. This action cannot be undone.</string>
<key>items</key><dict><key>NSStringFormatSpecTypeKey</key><string>NSStringPluralRuleType</string><key>NSStringFormatValueTypeKey</key><string>lld</string>
<key>one</key><string>%lld item</string><key>other</key><string>%lld items</string></dict>
</dict>
</dict></plist>
